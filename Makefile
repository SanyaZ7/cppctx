# ----------------------------------------------------------------------
#  Общие переменные
# ----------------------------------------------------------------------
CXX      = g++
CXXFLAGS = -Wall -Wextra -std=c++2a -O2 -s \
           -fdata-sections -ffunction-sections -flto -std=c++20
LDFLAGS  = -I/usr/include/boost
LIBS     = -lboost_serialization -lboost_system -lboost_thread \
           -lboost_json -lssl -lcrypto -lnghttp2 -lz -lpqxx -lpq

# ----------------------------------------------------------------------
#  Поиск всех *.cpp в текущем каталоге
# ----------------------------------------------------------------------
SRCS = $(wildcard *.cpp)

# ----------------------------------------------------------------------
#  Тестовые файлы – имена начинаются с «test_»
# ----------------------------------------------------------------------
TEST_SRCS = $(wildcard test_*.cpp)                    # test_foo.cpp, …
TEST_EXES = $(patsubst test_%.cpp,%,$(TEST_SRCS))    # foo, bar, …

# ----------------------------------------------------------------------
#  Файлы, в которых есть int main (но НЕ тесты)
# ----------------------------------------------------------------------
MAIN_SRCS = $(filter-out $(TEST_SRCS), \
             $(shell grep -l "^\s*int\s\+main\s*" $(SRCS) 2>/dev/null))

# ----------------------------------------------------------------------
#  Имя главного исполняемого файла – берём название каталога
# ----------------------------------------------------------------------
EXE_NAME = $(notdir $(CURDIR))

# ----------------------------------------------------------------------
#  Объектные файлы
# ----------------------------------------------------------------------
# 1) «Обычные» .cpp (не main и не test) → объект
OTHER_SRCS = $(filter-out $(MAIN_SRCS) $(TEST_SRCS),$(SRCS))

# 2) Объекты из main‑файла (нужны только для главного exe)
MAIN_OBJS = $(patsubst %.cpp,obj/%.o,$(MAIN_SRCS))

# 3) Объекты из тестов (по отдельности)
TEST_OBJS = $(patsubst %.cpp,obj/%.o,$(TEST_SRCS))

# 4) Общие объекты (используются и в главном exe, и в тестах)
COMMON_OBJS = $(patsubst %.cpp,obj/%.o,$(OTHER_SRCS))

# Полный список всех объектных файлов, хранящихся в каталоге obj/
OBJS = $(COMMON_OBJS) $(MAIN_OBJS) $(TEST_OBJS)

# ----------------------------------------------------------------------
#  Основные цели
# ----------------------------------------------------------------------
.PHONY: all clean

# ----------------------------------------------------------------------
#  Главная цель
# ----------------------------------------------------------------------
all: obj $(OBJS) $(EXE_NAME) $(TEST_EXES)
	@echo "Проверка наличия Makefile в поддиректориях..."
	@for dir in */ ; do \
		if [ "$$dir" != "obj/" ] && [ -f "$$dir/Makefile" ]; then \
			echo "Найден Makefile в директории: $$dir"; \
			$(MAKE) -C "$${dir%*/}"; \
		elif [ "$$dir" != "obj/" ]; then \
			echo "В директории $$dir нет файла Makefile"; \
		fi; \
	done

# ----------------------------------------------------------------------
#  Создаём каталог obj/, если его ещё нет
# ----------------------------------------------------------------------
obj:
	@mkdir -p $@

# ----------------------------------------------------------------------
#  Правило построения объектных файлов (с генерацией .d‑зависимостей)
# ----------------------------------------------------------------------
obj/%.o: %.cpp
	$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

# ----------------------------------------------------------------------
#  Линковка главного исполняемого файла (имя = имя каталога)
# ----------------------------------------------------------------------
$(EXE_NAME): $(COMMON_OBJS) $(MAIN_OBJS)
	@echo "Linking main executable → $@"
	$(CXX) -o $@ $^ $(LDFLAGS) $(LIBS)

# ----------------------------------------------------------------------
#  Линковка тестов
#  Каждый тест → отдельный exe без префикса «test_»
# ----------------------------------------------------------------------
$(TEST_EXES): %: obj/test_%.o $(COMMON_OBJS)
	@echo "Linking test executable → $@"
	$(CXX) -o $@ $^ $(LDFLAGS) $(LIBS)

# ----------------------------------------------------------------------
#  Подключаем автоматически сгенерированные зависимости
# ----------------------------------------------------------------------
-include $(OBJS:.o=.d)

# ----------------------------------------------------------------------
#  Очистка
# ----------------------------------------------------------------------
clean:
	@echo "Cleaning project …"
	rm -rf obj $(EXE_NAME) $(TEST_EXES)
	@echo "Очистка поддиректорий..."
	@for dir in */ ; do \
		if [ "$$dir" != "obj/" ] && [ -f "$$dir/Makefile" ]; then \
			echo "  -> cleaning $${dir%*/}"; \
			$(MAKE) -C "$${dir%*/}" clean; \
		fi; \
	done

